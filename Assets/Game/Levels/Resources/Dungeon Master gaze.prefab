  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 59d26d4d6c9b9984dba96c2e7af21453, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DungeonMasterGaze
  watchOn: 1
  watchWeight: 0.7
  watchSeconds: {x: 8, y: 16}
  restSeconds: {x: 2.5, y: 5}
  fightReach: 12
  stareAngle: 7
  headSize: 6
  stareWithin: 90
  stareSeconds: 1.6
  stareGap: 40
  firstLines:
  - text: Yes. That's me up here.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  - text: Eyes on the board.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  - text: I can see you staring.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  moreLines:
  - text: What? Have I got something on my face?
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  - text: Don't look at me. Look at them.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  - text: I'm not part of the dungeon.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  - text: The dungeon is down there.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  - text: Stop that.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  fightLines:
  - text: Not me. Them.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  - text: Watch your fight, not me.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
