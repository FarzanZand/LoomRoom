  forceFace: 0
  maxTier: 2
  enterLine:
    text: One roll. Shake the cup if you dare, and the board says what you get.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 0
  rollLine:
    text: Let's see what the dice say.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 0
  faceLines:
  - text: A one. Oh dear.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 0
  - text: A two gets you a friend of mine.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 0
  - text: Three does nothing at all.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 0
  - text: Four puts you back on your feet.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 0
  - text: Five, not bad.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 0
  - text: Six! Lucky you.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 0
