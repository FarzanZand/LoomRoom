  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 58f99defc8213ab409eb037a3668036c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TavernRoom
  bossAhead:
  - text: Something big waits {Floors} down. Eat first.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  - text: Rest while you can. The bottom of this place bites back.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  bossNext:
  - text: The next stairs go down to something that won't share the room.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  portalHere:
  - text: There's an arch on this floor that doesn't lead where arches lead.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  plain:
  - text: Sit. Nothing follows you in here.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  - text: Even I need a break from you sometimes.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  - text: The stew is better than it looks.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  hintChance: 0.7
