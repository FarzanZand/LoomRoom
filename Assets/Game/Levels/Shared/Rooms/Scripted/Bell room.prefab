  m_Script: {fileID: 11500000, guid: a6e55f169ed17094397467e6e5c39c9e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BellEvent
  bell: {fileID: 5873039649171769337}
  chest: {fileID: 4869872310830436034}
  toll: {fileID: 8300000, guid: 4fa5f8f03690bb94cb58706d3f88e5ba, type: 3}
  tollVolume: 1
  waves: 02000000030000000400000005000000
  wavesPerRing: 3
  legendaryLast: 1
  maxTier: 2
  ringLines:
  - text: You rang?
    voice: {fileID: 0}
    mumble: 1
    inPerson: 0
  - text: Again? Fine.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 0
  - text: You want more, then.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 0
  - text: This is the last one. I mean it.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 0
  waveLines:
  - text: Another.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 0
  - text: The last of them.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 0
  chestShutPrompt: Not while they're coming
  chestShutLine:
    text: Finish what you rang for first.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 0
  clearedLine:
    text: The chest looks better already.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 0
  cashOutLine:
    text: Stopping now is the sensible thing.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 0
  doneLine:
    text: That's all the bell has.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 0
