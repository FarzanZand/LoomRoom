    mumble: 0
    inPerson: 0
  - text: Rats first. Then worse.
    voice: {fileID: 11400000, guid: 045015f9783e17b41a1ed39ab26c3999, type: 2}
    mumble: 0
    inPerson: 0
  - text: Take it slow this time.
    voice: {fileID: 11400000, guid: 045015f9783e17b41a1ed39ab26c3999, type: 2}
    mumble: 0
    inPerson: 0
  - text: Same cellars. New rooms.
