  entryLines:
  - text: The crypt now.
    voice: {fileID: 11400000, guid: 045015f9783e17b41a1ed39ab26c3999, type: 2}
    mumble: 0
    inPerson: 0
  - text: The dead don't like visitors.
    voice: {fileID: 11400000, guid: 045015f9783e17b41a1ed39ab26c3999, type: 2}
    mumble: 0
    inPerson: 0
  - text: Keep your shield up.
    voice: {fileID: 11400000, guid: 045015f9783e17b41a1ed39ab26c3999, type: 2}
    mumble: 0
    inPerson: 0
  - text: Not many get this far.
    voice: {fileID: 11400000, guid: 045015f9783e17b41a1ed39ab26c3999, type: 2}
    mumble: 0
    inPerson: 0
