  m_Script: {fileID: 11500000, guid: 02e880c6cad83af4884eda9bc09ce428, type: 3}
  m_Name: Tavern keeper
  m_EditorClassIdentifier: Assembly-CSharp::TavernKeeperDialogueData
  welcomeLines:
  - Welcome in! Wipe your boots. Whatever you stepped in out there, it stays outside.
  - Ah, a customer who's still breathing. My favourite kind. They pay.
  - Sit anywhere you like. Don't mind the smell, that's the stew. Mostly.
  shopAnswer: Shop
  rumourAnswer: Rumour ({Price} gold)
  leaveAnswer: Never mind
  noMoneyLine: A rumour is {Price} gold, friend. You've got {Gold}. I can count, you know.
  noRumourLine: That's all I know for now. Come back when the world's done something interesting.
  rumourFallbackLine: I heard of a place. That's all I'll say.
