  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5e92c5d93d720bb4db75ea233631ccad, type: 3}
  m_Name: Edgar the Disco King
  m_EditorClassIdentifier: Assembly-CSharp::BossDialogueData
  bossName: Edgar the Disco King
  introLines:
  - speaker: 0
    name: 
    model: {fileID: 0}
    text: Well, well. Someone found my dance floor.
    choices: []
  - speaker: 0
    name: 
    model: {fileID: 0}
    text: Nobody has come down those stairs in a hundred years. The music got lonely.
    choices: []
  - speaker: 0
    name: 
    model: {fileID: 0}
    text: So tell me. Do you want to party?
    choices:
    - label: Yes
      reply:
      - speaker: 0
        name: 
        model: {fileID: 0}
        text: Finally, someone with taste! Try to keep up.
    - label: No
      reply:
      - speaker: 0
        name: 
        model: {fileID: 0}
        text: Nobody says no to the disco king. You're dancing anyway!
  - speaker: 1
    name: 
    model: {fileID: 0}
    text: You heard the king. Dance.
    choices: []
  phaseTwoLine: Let's turn it up!
  backupCallLine: Boys! Get in here!
  backupBrokenLine: Hey! That was my crew!
