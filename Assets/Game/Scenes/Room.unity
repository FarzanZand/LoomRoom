--- !u!114 &87319290
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 83857682}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9d2487d19a3278b47bf823703251d030, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DungeonMasterRemarks
  morning:
  - text: Morning.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  - text: You're up.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  callOver:
  - text: Over here. Come and talk to me.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  idle:
  - text: Whenever you're ready.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  - text: The table's waiting.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  door:
  - text: It does not go anywhere. You are not allowed to leave yet.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  doorAgain:
  - text: It still doesn't go anywhere.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  greetingDelay: 1.5
  idleSeconds: 75
  doorLoopAgainAt: 4
  again:
  - text: Again.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  - text: Back so soon.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  further:
  - text: Further than before.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  - text: Deeper this time.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  sameKiller:
  - text: The {killer} again.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  - text: Beaten by the {killer} again.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  afterTheEnd:
  - text: Again?
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  newFigure:
  - text: You haven't tried this one.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  usualPick:
  - text: You always pick that one.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 0
  - text: Your favourite.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 0
  samePick:
  - text: That one again.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 0
  - text: Let's see if it goes better this time.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 0
  newPick:
  - text: That's new.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 0
  spellHitMe:
  - text: Did you just throw that at me?
    voice: {fileID: 0}
    mumble: 1
    inPerson: 0
  - text: Careful. I can see you.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 0
  - text: That's not how this game works.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 0
  - text: Aim at the monsters, not at me.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 0
  spellHitGap: 8
  closeCallFraction: 0.25
  remarkGap: 15
  runRemarkDelay: 1.5
