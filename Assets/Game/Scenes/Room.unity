  figuresOffered: 2
  sheetOnFirstMorning: 1
  sheetUnknownClass: Adventurer
  nightTime: {x: 2, y: 47}
  callLines:
  - text: You're up. Good.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  - text: Come and sit. Everything's set up.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  nudgeLines:
  - text: The table's over here.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  - text: I'm not going anywhere. Neither is the game.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  - text: Whenever you're ready.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  lampLines:
  - text: You never remember the rules. That's alright. I do.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  morningSheetLines:
  - text: Morning. A new character. Fill it in as we go.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  sheetLines:
  - text: A new character. Fill it in as we go.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  rollLines:
  - text: Strength first. Three dice.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  - text: Intelligence.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  - text: And constitution. How long you last.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  lowRoll:
  - text: '{n}. Well. Someone has to be the underdog.'
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  - text: '{n}. We''ll say you''re modest.'
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  - text: '{n}. It happens.'
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  midRoll:
  - text: '{n}. That''ll do.'
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  - text: '{n}. Respectable.'
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  - text: '{n}. Fine. Write it down.'
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  highRoll:
  - text: '{n}. Don''t get used to that.'
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  - text: '{n}! Lucky.'
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  - text: '{n}. Now I''m worried.'
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  tripleRoll:
  - text: Triples. I didn't know these dice could do that.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  - text: All the same. Write that down before it changes.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  afterRolls:
  - text: Let's see who that is.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  tabletopAfterPractice:
  - text: And that's how it usually goes.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  - text: I'll cross him off.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  memorialLines:
  - text: He goes on the shelf, with the others.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  tabletopGoodnight:
  - text: We'll start properly in the morning. Get some sleep.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  rollHint: Click to roll the dice (or press Space).
  seat: {fileID: 2129211305}
  eyeHeight: 0.55
  zoom: -24
  aimBelowHead: 7
  roomLighting: 2
  roomTint: {r: 1, g: 1, b: 1, a: 1}
  tabletopRoomLighting: 0
