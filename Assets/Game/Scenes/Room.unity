  dmEyes: {fileID: 1997636109}
  lighting: {fileID: 1275394512}
  openingBlack: 2
  openingFade: 3
  beforeLamp:
  - text: There you are.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  - text: Hold still. I can't find the lamp.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  afterLamp:
  - text: There.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  - text: Good. You're awake.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  - text: We're going to play a game.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  - text: You'll be one small figure. I'll be everything else.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  - text: We'll start you on something small. I don't want to break you on the first
      night.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  openingRule: {fileID: 11400000, guid: 614a8b8107d3a33428d605ef0ee9c5f2, type: 2}
  openingRuleAfter: 3
  lampSound: {fileID: 0}
  introDungeon: {fileID: 11400000, guid: c645aab0a734a674c819d23a78475cc7, type: 2}
  practiceClass: {fileID: 11400000, guid: 720138e1d8556ba48b73655c9111a72d, type: 2}
  takeIt:
    text: This one's yours. Pick him up.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  firstStepDelay: 2
  steps:
  - goal: 0
    room: -1
    amount: 6
    line:
      text: Cold stone. Rats somewhere. Look around.
      voice: {fileID: 0}
      mumble: 1
      inPerson: 0
    doneLine:
      text: 
      voice: {fileID: 0}
      mumble: 1
      inPerson: 0
    hint: Move with {Move}. Look with the mouse.
    hintDelay: 5
    giveUpAfter: 0
  - goal: 3
    room: 0
    amount: 1
    line:
      text: Open the chest.
      voice: {fileID: 0}
      mumble: 1
      inPerson: 0
    doneLine:
      text: Keep it. Until your figure dies.
      voice: {fileID: 0}
      mumble: 1
      inPerson: 0
    hint: Open the chest and pick things up with {Interact}. Barrels and crates break.
      Your bag is on {Inventory}.
    hintDelay: 8
    giveUpAfter: 60
  - goal: 2
    room: 1
    amount: 2
    line:
      text: Two rats. Kill them. When one jumps, raise your shield.
      voice: {fileID: 0}
      mumble: 1
      inPerson: 0
    doneLine:
      text: Good.
      voice: {fileID: 0}
      mumble: 1
      inPerson: 0
    hint: Attack with {PrimaryAction}. Hold {SecondaryAction} to block.
    hintDelay: 6
    giveUpAfter: 0
  - goal: 2
    room: 2
    amount: 3
    line:
      text: A guard, facing the wall. He hasn't seen you. Crouch with {Crouch}, creep
        up and stab him in the back.
      voice: {fileID: 0}
      mumble: 1
      inPerson: 0
    doneLine:
      text: The ladder's in the next room.
      voice: {fileID: 0}
      mumble: 1
      inPerson: 0
    hint: Crouch with {Crouch}. Hit him from behind for a backstab.
    hintDelay: 4
    giveUpAfter: 45
  - goal: 5
    room: -1
    amount: 15
    line:
      text: 
      voice: {fileID: 0}
      mumble: 1
      inPerson: 0
    doneLine:
      text: 
      voice: {fileID: 0}
      mumble: 1
      inPerson: 0
    hint: 
    hintDelay: 99
    giveUpAfter: 0
  roomQuests:
  - room: 0
    id: intro.landing
    text: Loot the chest.
  - room: 1
    id: intro.rats
    text: Kill the rats. Block with {block}.
  - room: 2
    id: intro.guard
    text: Crouch ({crouch}) and stab the guard in the back.
  - room: 3
    id: intro.ladder
    text: Find the ladder out.
  idleLine:
    text: I can wait. I have all night.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 0
  idleSeconds: 12
  hurtLine:
    text: Careful. That chips the paint.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 0
  finaleRoom: 3
  enough:
    text: 
    voice: {fileID: 0}
    mumble: 1
    inPerson: 0
  killerComing:
    text: Something's coming down the ladder.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 0
  killer: {fileID: 642504646530285115, guid: bd8b4f7112b969642b0413e17be3273a, type: 3}
  killerHealth: 10
  killerDamage: 3
  killerLine:
    text: I wasn't going to show you this one yet.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 0
  killerSeconds: 12
  timeUp:
    text: No. That one was always going to die.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 0
  killerHitsToVolley: 3
  tooLong:
    text: You are not supposed to live that long. I have things to do.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 0
  volleyDelay: 2
  volleySpell: {fileID: 11400000, guid: 97ab782aa2e5c9545b64aafe17d3c498, type: 2}
  volleyDamage: 60
  killerVolley:
    count: 3
    spawnInterval: 0.5
    rise: 1.2
    spread: 1.3
    riseSeconds: 0.35
    holdSeconds: 0.25
    launchInterval: 0.45
    rampSeconds: 0.35
    scale: 1.3
    homing: 1
  afterPractice:
  - text: When a figure dies, it stays dead. That's the one rule I never bend.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  diedAtEnd:
    text: That one's done. I'll put it with the others.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  diedEarly:
    text: Killed by {killer}. I'll put it with the others anyway.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  goodnight:
  - text: Enough for tonight. Get some sleep.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  lampOutSound: {fileID: 0}
  eyesLinger: 1
  nightSeconds: 1
  firstMorning:
  - text: Morning. The table's ready when you are.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  skipInEditor: 0
