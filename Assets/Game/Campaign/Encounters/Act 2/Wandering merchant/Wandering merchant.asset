MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5194851c32051054bbb833cabc695459, type: 3}
  m_Name: Wandering merchant
  m_EditorClassIdentifier: Assembly-CSharp::CampaignEvent
  id: merchant
  title: The Wandering Merchant
  art: {fileID: 21300000, guid: 78002a4c318ead2469d4e197e5f1ddaf, type: 3}
  text: 'Where the new road starts, a man has stopped his cart for the night. He
    has a fire going and a cart full of odd things.


    "No gold, friend. Baubles.
    The bits you bring back from down there. I pay well for them."


    He holds
    up a garnet ring, then a pair of red flasks.'
  afterAct: 2
  choices:
  - label: Trade for the ring
    spoilsCost: 10
    spoilsGain: 0
    nextRunItems:
    - {fileID: 11400000, guid: ab6f16f47978a9640aaf59e418d98b96, type: 2}
    outcome: 'He weighs each bauble in his hand, nods, and drops the ring into your
      palm.


      "Wear it next time you go down. It brings people back."


      The
      Garnet ring will be in your pack at the start of your next run.'
    line:
      text: A ring for a bag of bones. Not a bad trade.
      voice: {fileID: 0}
      mumble: 1
      inPerson: 1
  - label: Trade for the flasks
    spoilsCost: 4
    spoilsGain: 0
    nextRunItems:
    - {fileID: 11400000, guid: 19d156fcb4bb95c4e8f0d4d53f3d6f61, type: 2}
    - {fileID: 11400000, guid: 19d156fcb4bb95c4e8f0d4d53f3d6f61, type: 2}
    outcome: 'He takes the baubles without counting them and hands over two flasks,
      still warm from the fire.


      Two healing potions will be in your pack
      at the start of your next run.'
    line:
      text: Two flasks. Drink them before you need them.
      voice: {fileID: 0}
      mumble: 1
      inPerson: 1
  - label: Send him on his way
    spoilsCost: 0
    spoilsGain: 0
    nextRunItems: []
    outcome: 'He shrugs, packs up his cart and rolls off down the road.


      "I''ll
      be around," he says over his shoulder.'
    line:
      text: Your loss. He had good stuff.
      voice: {fileID: 0}
      mumble: 1
      inPerson: 1
  continueLabel: Continue
