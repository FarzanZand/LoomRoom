  m_Name: The Arena
  m_EditorClassIdentifier: Assembly-CSharp::CampaignEncounter
  id: arena
  displayName: The Arena
  kind: 0
  level: {fileID: 11400000, guid: 49870adc04097c947a67a649fe40c570, type: 2}
  act: 1
  description: A ring of stone and sand. Someone is always waiting in it.
  pickedLine:
    text: The arena, then. Try not to bore him.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  deathsToOpen: 0
  deathsIn: {fileID: 11400000, guid: ffada713b3f1ff943955248d41bd14a9, type: 2}
  openedLine:
    text: Two deaths in the Crypt. Try the arena instead. At least there is a crowd.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  shutHint:
    text: Die there once more and I will show you something else.
    voice: {fileID: 0}
    mumble: 1
    inPerson: 1
  rumoured: 1
  rumour: Some who wander off past the Crypt come back with sand in their boots.
    Some come back with a crowd still cheering in their ears.
  rumourTold: There's a pit not far from the Crypt where they fight for a crowd.
    A champion waits in it. Nobody has thrown him out yet.
